      "reason": "cartridge artifacts"
    },
    {
      "class": "os_authoritative",
      "prefix": "0_kernel/schemas/",
      "reason": "OS schemas"
    },
    {
      "class": "os_authoritative",
      "prefix": "0_kernel/registry/",
      "reason": "OS registry"
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_only_or_external_dependency_pointer",
      "prefix": "0_kernel/vendor/",
      "reason": "vendored dependency snapshot"
    },
    {
      "class": "os_authoritative",
      "prefix": "0_kernel/",
      "reason": "kernel catch-all"
    },
    {
      "class": "os_authoritative",
      "prefix": "1_cartridges/",
      "reason": "legacy cartridge artifacts"
    },
    {
      "class": "os_authoritative",
      "prefix": "1_governance/",
      "reason": "legacy governance artifacts"
    },
    {
      "class": "os_authoritative",
      "prefix": "2_engines/",
      "reason": "OS engine artifacts"
    },
    {
      "class": "os_authoritative",
      "prefix": "2_evidence/",
      "reason": "evidence artifacts"
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_or_manifest_only",
      "prefix": "3_data/",
      "reason": "OS data plane artifacts"
    },
    {
      "class": "boot_kernel_source",
      "prefix": "scripts/mpp/",
      "reason": "boot kernel source subset",
      "selection_rule": "commit_only_if_invoked_by_mpp_or_route_contract"
    },
    {
      "class": "boot_kernel_source",
      "prefix": "scripts/",
      "reason": "non-MPP script source subset",
      "selection_rule": "commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation"
    },
    {
      "class": "boot_kernel_source",
      "prefix": "tools/metablooms/",
      "reason": "selected executable source subset",
      "selection_rule": "commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation"
    },
    {
      "class": "boot_kernel_source",
      "prefix": "tools/mpp/",
      "reason": "MPP tool source subset",
      "selection_rule": "commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation"
