{
  "default_decision": "UNCLASSIFIED_BLOCK_MOVEMENT",
  "generated_runtime_state_policy": {
    "block_if_source_paths_use_generated_runtime_state": true,
    "block_if_unclassified": true,
    "count_in_generated_drift": true,
    "count_in_strict_denominator": false,
    "strict_parity": false
  },
  "matching_policy": "safety_precedence_then_longest_specificity_match",
  "rules": [
    {
      "class": "private_excluded",
      "contains": "secret",
      "reason": "secret-like path exclusion"
    },
    {
      "class": "private_excluded",
      "contains": "token",
      "reason": "token-like path exclusion"
    },
    {
      "class": "release_asset_only",
      "reason": "large OS/export archive",
      "suffix": ".tar.zst"
    },
    {
      "class": "release_asset_only",
      "reason": "generated review/export bundle",
      "suffix": ".zip"
    },
    {
      "class": "os_authoritative_with_github_pr_proposal_path",
      "pattern": "governance/github_os_sync/SYNC_AUTHORITY_MAP_v1.json",
      "reason": "bootstrap reconciliation authority"
    },
    {
      "class": "github_authoritative",
      "prefix": ".github/",
      "reason": "repo workflow/control plane"
    },
    {
      "class": "github_authoritative",
      "prefix": ".claude/",
      "reason": "Claude Code repo hook/control plane"
    },
    {
      "class": "github_authoritative",
      "pattern": "README.md",
      "reason": "repo documentation root"
    },
    {
      "class": "github_authoritative",
      "pattern": "AGENTS.md",
      "reason": "repo agent instructions"
    },
