    },
    {
      "class": "github_authoritative",
      "pattern": "CONTRIBUTING.md",
      "reason": "repo contribution policy"
    },
    {
      "class": "github_authoritative",
      "pattern": "AUTHORITY_MAP.md",
      "reason": "repo authority documentation"
    },
    {
      "class": "github_authoritative",
      "pattern": "REPO_MAP.md",
      "reason": "repo map documentation"
    },
    {
      "class": "github_authoritative",
      "pattern": "MIGRATION_INVENTORY.json",
      "reason": "repo migration inventory"
    },
    {
      "class": "github_authoritative",
      "pattern": "MIGRATION_RECEIPT.md",
      "reason": "repo migration receipt"
    },
    {
      "class": "github_authoritative",
      "prefix": "governance/tool_routing/",
      "reason": "repo-native governance control plane"
    },
    {
      "class": "github_authoritative",
      "prefix": "governance/blocker_ledger/",
      "reason": "repo-native blocker ledger code"
    },
    {
      "class": "github_authoritative",
      "prefix": "governance/claude_code_workflows/",
      "reason": "repo-native Claude Code workflows"
    },
    {
      "class": "github_authoritative",
      "prefix": "governance/chat_export_mining/",
      "reason": "repo-native chat export mining cartridge"
    },
    {
      "class": "os_authoritative",
      "prefix": "governance/github_os_sync/",
      "reason": "sync workflow governance contracts"
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_only",
      "prefix": "governance/improvement_log/",
      "reason": "improvement log evidence"
    },
    {
      "class": "os_authoritative",
      "prefix": "governance/sop/",
