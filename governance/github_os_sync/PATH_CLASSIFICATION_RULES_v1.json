{
  "schema": "mb.github_os_sync.path_classification_rules.v1",
  "default_decision": "UNCLASSIFIED_BLOCK_MOVEMENT",
  "safety_precedence": ["private_excluded", "release_asset_only"],
  "matching_policy": "safety_precedence_then_longest_specificity_match",
  "rules": [
    {"contains":"secret","class":"private_excluded","reason":"secret-like path exclusion"},
    {"contains":"token","class":"private_excluded","reason":"token-like path exclusion"},
    {"suffix":".tar.zst","class":"release_asset_only","reason":"large OS/export archive"},
    {"suffix":".zip","class":"release_asset_only","reason":"generated review/export bundle"},
    {"pattern":"governance/github_os_sync/SYNC_AUTHORITY_MAP_v1.json","class":"os_authoritative_with_github_pr_proposal_path","reason":"bootstrap reconciliation authority"},
    {"prefix":".github/","class":"github_authoritative","reason":"repo workflow/control plane"},
    {"prefix":".claude/","class":"github_authoritative","reason":"Claude Code repo hook/control plane"},
    {"pattern":"README.md","class":"github_authoritative","reason":"repo documentation root"},
    {"pattern":"AGENTS.md","class":"github_authoritative","reason":"repo agent instructions"},
    {"pattern":"CLAUDE.md","class":"github_authoritative","reason":"repo Claude instructions"},
    {"pattern":"SECURITY.md","class":"github_authoritative","reason":"repo security policy"},
    {"pattern":"CONTRIBUTING.md","class":"github_authoritative","reason":"repo contribution policy"},
    {"pattern":"AUTHORITY_MAP.md","class":"github_authoritative","reason":"repo authority documentation"},
    {"pattern":"REPO_MAP.md","class":"github_authoritative","reason":"repo map documentation"},
    {"pattern":"MIGRATION_INVENTORY.json","class":"github_authoritative","reason":"repo migration inventory"},
    {"pattern":"MIGRATION_RECEIPT.md","class":"github_authoritative","reason":"repo migration receipt"},
    {"prefix":"governance/tool_routing/","class":"github_authoritative","reason":"repo-native governance control plane"},
    {"prefix":"governance/blocker_ledger/","class":"github_authoritative","reason":"repo-native blocker ledger code"},
    {"prefix":"governance/claude_code_workflows/","class":"github_authoritative","reason":"repo-native Claude Code workflows"},
    {"prefix":"governance/chat_export_mining/","class":"github_authoritative","reason":"repo-native chat export mining cartridge"},
    {"prefix":"governance/github_os_sync/","class":"os_authoritative","reason":"sync workflow governance contracts"},
    {"prefix":"governance/improvement_log/","class":"os_authoritative","github_projection":"summary_only","reason":"improvement log evidence"},
    {"prefix":"governance/sop/","class":"os_authoritative","reason":"SOP documents"},
    {"prefix":"governance/sops/","class":"os_authoritative","reason":"SOP documents"},
    {"prefix":"governance/","class":"os_authoritative","reason":"governance catch-all after repo-native rules"},
    {"prefix":"audits/","class":"os_authoritative","github_projection":"summary_or_diff_packet_only","reason":"repo-side audit evidence"},
    {"prefix":"artifacts/","class":"os_authoritative","github_projection":"summary_or_release_asset_only","reason":"artifact evidence"},
    {"prefix":"contracts/","class":"os_authoritative","reason":"engine contracts"},
    {"prefix":"externalization/","class":"release_asset_only","reason":"externalized OS export/pointer evidence"},
    {"prefix":"incoming/","class":"os_authoritative","github_projection":"summary_only","reason":"incoming operator packets"},
    {"prefix":"memory-sync/","class":"os_authoritative","github_projection":"summary_only","reason":"memory sync evidence"},
    {"prefix":"metablooms_checkpoints/","class":"os_authoritative","github_projection":"summary_only","reason":"checkpoint evidence"},
    {"prefix":"metablooms_sidechat_research/","class":"os_authoritative","github_projection":"summary_or_diff_packet_only","reason":"sidechat research evidence"},
    {"prefix":"prompts/","class":"github_authoritative","reason":"repo prompt/handoff source"},
    {"prefix":"release_artifacts/","class":"release_asset_only","reason":"release artifacts should not be source-of-truth Git history"},
    {"prefix":"runtimes/","class":"os_authoritative","github_projection":"summary_or_release_asset_only","reason":"runtime outputs"},
    {"prefix":"source_materials/","class":"os_authoritative","github_projection":"summary_or_external_source_pointer","reason":"source material evidence"},
    {"prefix":"docs/","class":"os_authoritative","reason":"OS/repo documentation"},
    {"prefix":"fixtures/","class":"os_authoritative","github_projection":"summary_or_diff_packet_only","reason":"fixture artifacts"},
    {"prefix":"receipts/","class":"os_authoritative","github_projection":"summary_only","reason":"legacy/top-level receipts"},
    {"pattern":"runtime/state/ACTIVE_TRACKER_PREVIEW.txt","class":"generated_runtime_state","strict_parity":false,"reason":"binding gate output; excluded from strict parity denominator"},
    {"pattern":"runtime/state/ACTIVE_WORK.json","class":"generated_runtime_state","strict_parity":false,"reason":"binding gate work state; excluded from strict parity denominator"},
    {"prefix":"runtime/","class":"os_authoritative","github_projection":"summary_or_diff_packet_only","reason":"runtime data plane"},
    {"prefix":"0_kernel/mpp_v3/","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation","reason":"MPP kernel source subset"},
    {"prefix":"0_kernel/scripts/","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation","reason":"OS kernel scripts source subset"},
    {"prefix":"0_kernel/cartridges/","class":"os_authoritative","reason":"cartridge artifacts"},
    {"prefix":"0_kernel/schemas/","class":"os_authoritative","reason":"OS schemas"},
    {"prefix":"0_kernel/registry/","class":"os_authoritative","reason":"OS registry"},
    {"prefix":"0_kernel/vendor/","class":"os_authoritative","github_projection":"summary_only_or_external_dependency_pointer","reason":"vendored dependency snapshot"},
    {"prefix":"0_kernel/","class":"os_authoritative","reason":"kernel catch-all"},
    {"prefix":"1_cartridges/","class":"os_authoritative","reason":"legacy cartridge artifacts"},
    {"prefix":"1_governance/","class":"os_authoritative","reason":"legacy governance artifacts"},
    {"prefix":"2_engines/","class":"os_authoritative","reason":"OS engine artifacts"},
    {"prefix":"2_evidence/","class":"os_authoritative","reason":"evidence artifacts"},
    {"prefix":"3_data/","class":"os_authoritative","github_projection":"summary_or_manifest_only","reason":"OS data plane artifacts"},
    {"prefix":"scripts/mpp/","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract","reason":"boot kernel source subset"},
    {"prefix":"scripts/","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation","reason":"non-MPP script source subset"},
    {"prefix":"tools/metablooms/","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation","reason":"selected executable source subset"},
    {"prefix":"tools/mpp/","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation","reason":"MPP tool source subset"},
    {"prefix":"tools/","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation","reason":"tooling catch-all"},
    {"prefix":"tests/","class":"github_authoritative","reason":"repo validation source"},
    {"pattern":".*","class":"os_authoritative","github_projection":"summary_only","reason":"top-level hidden OS/repo control file"},
    {"pattern":"METABLOOMS_PREBOOT*","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation","reason":"top-level preboot rescue/bootstrap source"},
    {"pattern":"METABLOOMS_ROOTLESS*","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation","reason":"top-level rootless preboot bootstrap source"},
    {"pattern":"metablooms_recover*","class":"boot_kernel_source","selection_rule":"commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation","reason":"top-level recovery source"}
  ]
}
