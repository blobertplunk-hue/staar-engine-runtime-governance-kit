      "reason": "artifact evidence"
    },
    {
      "class": "os_authoritative",
      "prefix": "contracts/",
      "reason": "engine contracts"
    },
    {
      "class": "release_asset_only",
      "prefix": "externalization/",
      "reason": "externalized OS export/pointer evidence"
    },
    {
      "class": "os_authoritative",
