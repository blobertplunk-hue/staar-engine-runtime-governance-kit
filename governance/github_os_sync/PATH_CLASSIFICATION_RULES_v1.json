      "reason": "source material evidence"
    },
    {
      "class": "os_authoritative",
      "prefix": "docs/",
      "reason": "OS/repo documentation"
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_or_diff_packet_only",
      "prefix": "fixtures/",
      "reason": "fixture artifacts"
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_only",
      "prefix": "receipts/",
      "reason": "legacy/top-level receipts"
    },
    {
      "class": "generated_runtime_state",
      "pattern": "runtime/state/ACTIVE_TRACKER_PREVIEW.txt",
      "reason": "generated human-facing tracker preview; regenerated by visual tracker binding gate on boot",
      "strict_parity": false
    },
    {
      "class": "generated_runtime_state",
      "pattern": "runtime/state/ACTIVE_WORK.json",
      "reason": "mutable active-work state; current runtime context, not source-control authority",
      "strict_parity": false
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_or_diff_packet_only",
      "prefix": "runtime/",
      "reason": "runtime data plane"
    },
    {
      "class": "boot_kernel_source",
      "prefix": "0_kernel/mpp_v3/",
