      "class": "os_authoritative",
      "github_projection": "summary_or_diff_packet_only",
      "prefix": "metablooms_sidechat_research/",
      "reason": "sidechat research evidence"
    },
    {
      "class": "github_authoritative",
      "prefix": "prompts/",
      "reason": "repo prompt/handoff source"
    },
    {
      "class": "release_asset_only",
      "prefix": "release_artifacts/",
      "reason": "release artifacts should not be source-of-truth Git history"
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_or_release_asset_only",
      "prefix": "runtimes/",
      "reason": "runtime outputs"
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_or_external_source_pointer",
