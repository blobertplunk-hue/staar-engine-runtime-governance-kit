    },
    {
      "class": "boot_kernel_source",
      "pattern": "METABLOOMS_PREBOOT*",
      "reason": "top-level preboot rescue/bootstrap source",
      "selection_rule": "commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation"
    },
    {
      "class": "boot_kernel_source",
      "pattern": "METABLOOMS_ROOTLESS*",
      "reason": "top-level rootless preboot bootstrap source",
      "selection_rule": "commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation"
    },
    {
      "class": "boot_kernel_source",
      "pattern": "metablooms_recover*",
      "reason": "top-level recovery source",
      "selection_rule": "commit_only_if_invoked_by_mpp_or_route_contract_or_test_or_release_pointer_validation"
