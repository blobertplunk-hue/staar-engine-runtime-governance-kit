    {
      "class": "os_authoritative",
      "prefix": "governance/",
      "reason": "governance catch-all after repo-native rules"
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_or_diff_packet_only",
      "prefix": "audits/",
      "reason": "repo-side audit evidence"
    },
    {
      "class": "os_authoritative",
      "github_projection": "summary_or_release_asset_only",
