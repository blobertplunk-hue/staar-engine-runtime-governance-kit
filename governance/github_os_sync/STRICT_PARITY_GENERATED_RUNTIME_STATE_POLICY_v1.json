{
  "schema": "mb.github_os_sync.strict_parity_generated_runtime_state_policy.v1",
  "strict_parity": true,
  "generated_runtime_state": {
    "class": "generated_runtime_state",
    "strict_parity": false,
    "count_in_generated_drift": true,
    "count_in_strict_denominator": false,
    "paths": [
      "runtime/state/ACTIVE_TRACKER_PREVIEW.txt",
      "runtime/state/ACTIVE_WORK.json"
    ],
    "reason": "These files are regenerated by live OS runtime and tracked as generated drift, not source-parity failures."
  },
  "required_reporting": [
    "generated_state_drift_count",
    "generated_state_drift_paths",
    "strict_common_path_differences",
    "unclassified_paths"
  ]
}
